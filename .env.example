# 复制为 .env 并填入真实值 (cp .env.example .env)
# .env 被 .gitignore 排除, 绝不进版本库

# per-user 凭证加密主密钥 (Fernet)
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REMOTE_SENSING_MASTER_KEY=

# LLM 四选一 (DeepSeek / 智谱 / 通义 / MiniMax), 都空则零 key 优雅降级
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=

# 可选: 显式供应商 / 模型覆盖
# REMOTE_SENSING_LLM_PROVIDER=
# DEEPSEEK_HEAVY_MODEL=
# MINIMAX_HEAVY_MODEL=MiniMax-Text-01
